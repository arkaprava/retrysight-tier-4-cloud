# Production object storage archive — configure via Admin → Archive or inject at deploy time.
# Archive policy fields map to S3ArchiveSink (bucket, prefix, region, endpoint, keys).

# AWS S3 example:
# ARCHIVE_S3_BUCKET=retrysight-prod-archive
# ARCHIVE_S3_REGION=us-west-2
# ARCHIVE_S3_PREFIX=fleet-a/
# ARCHIVE_S3_ENDPOINT=          # leave empty for AWS
# ARCHIVE_S3_ACCESS_KEY=
# ARCHIVE_S3_SECRET_KEY=

# MinIO / on-prem S3-compatible:
# ARCHIVE_S3_ENDPOINT=https://minio.internal:9000
# ARCHIVE_S3_BUCKET=retrysight-archive
# ARCHIVE_S3_ACCESS_KEY=
# ARCHIVE_S3_SECRET_KEY=

# GCS via S3 interoperability endpoint:
# ARCHIVE_S3_ENDPOINT=https://storage.googleapis.com
# ARCHIVE_S3_BUCKET=your-bucket
