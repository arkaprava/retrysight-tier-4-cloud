POSTGRES_DB=agent_retry_cloud
POSTGRES_USER=retrysight_cloud
POSTGRES_PASSWORD=changeme-cloud
POSTGRES_PORT=5435

SPRING_PROFILES_ACTIVE=docker,tier-cloud
INSTALLATION_TIER=TIER_4_CLOUD

MANAGER_PORT=28477
FRONTEND_PORT=8086

JWT_SECRET=agent-retry-platform-dev-secret-key-32chars
CORS_ALLOWED_ORIGINS=http://localhost:8086,http://localhost:28477

SECADMIN_EMAIL=secadmin@local
SECADMIN_PASSWORD=changeme
SSO_SECRET_KEY=dev-sso-secret-encryption-key-32
SSO_CALLBACK_BASE_URL=http://localhost:8086
SSO_MANAGER_BASE_URL=http://localhost:28477

AGENT_API_KEY=dev-agent-key
AGENT_MANAGER_URL=http://manager:28477

SECURITY_ALLOW_DEFAULT_SECRETS=true

CLICKHOUSE_ENABLED=true
CLICKHOUSE_READ_ENABLED=true
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=agent_retry_cloud
CLICKHOUSE_HTTP_PORT=8125
CLICKHOUSE_NATIVE_PORT=9003

OTEL_INGEST_ENABLED=true
OTEL_COWORK_MAPPING_ENABLED=true
MCP_TOKEN_EXPIRATION_DAYS=7

# MinIO — dev object archive (replace with S3 in production)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9002
ARCHIVE_S3_BUCKET=retrysight-archive
ARCHIVE_S3_ENDPOINT=http://minio:9000
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_S3_ACCESS_KEY=minioadmin
ARCHIVE_S3_SECRET_KEY=minioadmin

RETENTION_TASK_EVENTS_DAYS=90
COMPOSE_PROJECT_NAME=retrysight-tier-cloud
