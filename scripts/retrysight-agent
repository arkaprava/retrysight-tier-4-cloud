#!/usr/bin/env bash
# Copyright (c) 2026 Arka Prava Ghosh
# SPDX-License-Identifier: Apache-2.0
# RetrySight agent CLI — configure, discover, status, and run.

set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSTALL_DIR="${RETRYSIGHT_AGENT_HOME:-${HOME}/.retrysight-agent}"
JAR="${RETRYSIGHT_AGENT_JAR:-${INSTALL_DIR}/agent-app.jar}"
CONFIG_DIR="${HOME}/.agent-retry"
CONFIG_FILE="${CONFIG_DIR}/config.yaml"
REPO_NAME="$(basename "${ROOT}")"

default_installation_tier() {
  case "${REPO_NAME}" in
    *tier-2*|*analytics*) echo TIER_2_ANALYTICS ;;
    *tier-3*|*integration*) echo TIER_3_INTEGRATION ;;
    *tier-4*|*cloud*) echo TIER_4_CLOUD ;;
    *) echo TIER_1_CORE ;;
  esac
}

default_spring_profile() {
  case "${REPO_NAME}" in
    *tier-2*|*analytics*) echo tier-analytics ;;
    *tier-3*|*integration*) echo tier-integration ;;
    *tier-4*|*cloud*) echo tier-cloud ;;
    *) echo tier-core ;;
  esac
}

resolve_jar() {
  if [[ -f "${JAR}" ]]; then
    return 0
  fi
  JAR="$(ls "${ROOT}"/agent/agent-app/target/agent-app-*.jar 2>/dev/null | head -1 || true)"
  [[ -n "${JAR}" && -f "${JAR}" ]]
}

usage() {
  cat <<EOF
Usage: retrysight-agent <command>

Commands:
  discover    Probe local IDE log directories (JSON)
  configure   Interactive first-run config bootstrap
  status      Show lock file, config, and jar path
  run         Run the collector agent (foreground)
  install     Copy jar + fleet config into \${HOME}/.retrysight-agent

Environment:
  RETRYSIGHT_AGENT_HOME   Install directory (default: \${HOME}/.retrysight-agent)
  RETRYSIGHT_AGENT_JAR    Explicit jar path
  AGENT_MANAGER_URL       Manager base URL
  AGENT_API_KEY           Fleet ingest API key
EOF
}

cmd_discover() {
  resolve_jar || { echo "Agent jar not found. Run ./scripts/package-agent.sh or ./scripts/build.sh" >&2; exit 1; }
  exec java -jar "${JAR}" \
    --agent.cli.command=discover \
    --agent.platform.auto-discovery=true \
    "$@"
}

cmd_configure() {
  mkdir -p "${CONFIG_DIR}"
  read -r -p "Manager URL [http://localhost:28477]: " manager_url
  manager_url="${manager_url:-http://localhost:28477}"
  read -r -p "Agent API key [dev-agent-key]: " api_key
  api_key="${api_key:-dev-agent-key}"
  read -r -p "Developer email (recommended): " dev_email
  local tier
  tier="$(default_installation_tier)"

  cat > "${CONFIG_FILE}" <<EOF
# Generated by retrysight-agent configure
agent:
  platform:
    installation-tier: ${tier}
    auto-discovery: true
  manager:
    url: ${manager_url}
    api-key: ${api_key}
  user:
    email: ${dev_email:-}
  discovery:
    recency-days: 30
  session:
    idle-complete-minutes: 30
  collectors: []
EOF
  echo "Wrote ${CONFIG_FILE}"
  cmd_discover
}

cmd_status() {
  echo "jar:    ${JAR}"
  echo "config: ${CONFIG_FILE}"
  echo "lock:   ${CONFIG_DIR}/agent.lock"
  if [[ -f "${CONFIG_DIR}/agent.lock" ]]; then
    echo "lock holder pid: $(tr -d '\n' < "${CONFIG_DIR}/agent.lock" 2>/dev/null || true)"
  fi
  if [[ -f "${CONFIG_FILE}" ]]; then
    echo "config present: yes"
  else
    echo "config present: no"
  fi
}

cmd_install() {
  resolve_jar || { echo "Build the agent first: ./scripts/build.sh" >&2; exit 1; }
  mkdir -p "${INSTALL_DIR}"
  cp "${JAR}" "${INSTALL_DIR}/agent-app.jar"
  if [[ -f "${ROOT}/config/agent/fleet-config.example.yaml" ]]; then
    cp "${ROOT}/config/agent/fleet-config.example.yaml" "${INSTALL_DIR}/config.example.yaml"
  fi
  echo "Installed jar to ${INSTALL_DIR}/agent-app.jar"
}

cmd_run() {
  resolve_jar || { echo "Agent jar not found." >&2; exit 1; }
  export SPRING_PROFILES_ACTIVE="${SPRING_PROFILES_ACTIVE:-$(default_spring_profile)}"
  exec java -jar "${JAR}" "$@"
}

main() {
  local cmd="${1:-run}"
  shift || true
  case "${cmd}" in
    discover) cmd_discover "$@" ;;
    configure) cmd_configure "$@" ;;
    status) cmd_status "$@" ;;
    install) cmd_install "$@" ;;
    run) cmd_run "$@" ;;
    -h|--help|help) usage ;;
    *) echo "Unknown command: ${cmd}" >&2; usage; exit 1 ;;
  esac
}

main "$@"
