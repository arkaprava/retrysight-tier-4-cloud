# Tier metadata consumed by CI scripts and Helm defaults.
TIER_SLUG=tier-cloud
INSTALLATION_TIER=TIER_4_CLOUD
SPRING_PROFILES=docker,tier-cloud
IMAGE_PREFIX=retrysight/tier-cloud

POSTGRES_DB=agent_retry_cloud
POSTGRES_USER=retrysight_cloud

MANAGER_PORT=28477
FRONTEND_PORT=8086

CLICKHOUSE_ENABLED=true
MINIO_ENABLED=true

DOCKER_COMPONENTS="postgres manager frontend"
