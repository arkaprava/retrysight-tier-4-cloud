# jpackage Linux DEB postrm — remove user unit file after package purge.
set -euo pipefail

UNIT_PATH="/usr/lib/systemd/user/retrysight-agent.service"

if [[ "${1:-}" == "purge" || "${1:-}" == "remove" ]]; then
  rm -f "${UNIT_PATH}"
  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
  fi
fi

exit 0
