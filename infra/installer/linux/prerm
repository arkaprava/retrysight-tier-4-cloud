# jpackage Linux DEB prerm — stop/disable user service before remove.
set -euo pipefail

UNIT_NAME="retrysight-agent.service"
TARGET_USER="${SUDO_USER:-${USER:-}}"

if command -v systemctl >/dev/null 2>&1; then
  systemctl --global disable "${UNIT_NAME}" >/dev/null 2>&1 || true
  if [[ -n "${TARGET_USER}" && "${TARGET_USER}" != "root" ]]; then
    runuser -l "${TARGET_USER}" -c "systemctl --user disable --now ${UNIT_NAME}" >/dev/null 2>&1 || true
  fi
fi

exit 0
