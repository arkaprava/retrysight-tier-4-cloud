<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.retrysight.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/java</string>
    <string>-jar</string>
    <string>__INSTALL_DIR__/agent-app.jar</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>WorkingDirectory</key>
  <string>__INSTALL_DIR__</string>
  <key>StandardOutPath</key>
  <string>/tmp/retrysight-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/retrysight-agent.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SPRING_PROFILES_ACTIVE</key>
    <string>__SPRING_PROFILE__</string>
  </dict>
</dict>
</plist>
