<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentretry.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/java</string>
    <string>-jar</string>
    <string>/opt/agent-retry-platform/agent/agent-app/target/agent-app-1.0.0.jar</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>/opt/agent-retry-platform</string>
  <key>StandardOutPath</key>
  <string>/tmp/agent-retry-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/agent-retry-agent.err</string>
</dict>
</plist>
