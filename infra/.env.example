# PostgreSQL (local Docker default). For enterprise BYO RDBMS, set SPRING_DATASOURCE_* instead — see docs/BYO_RDBMS.md
POSTGRES_DB=agent_retry
POSTGRES_USER=agent_retry
# CHANGE_ME before prod/docker deploy (SecurityBootstrapValidator rejects default)
POSTGRES_PASSWORD=agent_retry
POSTGRES_PORT=5432
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.example:5432/agent_retry
# SPRING_DATASOURCE_USERNAME=agent_retry_app
# SPRING_DATASOURCE_PASSWORD=

# Manager (default 28477 — odd port to avoid :8080 clashes; override MANAGER_PORT)
MANAGER_PORT=28477
# CHANGE_ME before prod/docker deploy — min 32 chars recommended
JWT_SECRET=agent-retry-platform-dev-secret-key-32chars
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080

# SSO / secadmin bootstrap (config-file only, never stored in DB)
SECADMIN_EMAIL=secadmin@local
# CHANGE_ME before prod/docker deploy
SECADMIN_PASSWORD=changeme
# CHANGE_ME before prod/docker deploy
SSO_SECRET_KEY=dev-sso-secret-encryption-key-32
SSO_CALLBACK_BASE_URL=http://localhost:5173
SSO_MANAGER_BASE_URL=http://localhost:28477

# Frontend (nginx)
FRONTEND_PORT=8080

# Agent (shared ingest key; manager seeds/syncs via manager.auth.agent-api-key)
# CHANGE_ME before prod/docker deploy
AGENT_API_KEY=dev-agent-key
# Dual-key grace after rotateApiKey (seconds); previous AGENT key stays valid
API_KEY_ROTATION_GRACE_SECONDS=86400
# Collectors with lastHeartbeatAt older than this are GraphQL/UI "stale"
MANAGER_AGENTS_STALE_AFTER_SECONDS=120

# Security hardening (docker/prod profiles)
# Set true only for local Docker dev with default secrets — never in production
SECURITY_ALLOW_DEFAULT_SECRETS=true
SECURITY_GRAPHIQL_ENABLED=false
SECURITY_REQUIRE_GRAPHQL_AUTH=true
SECURITY_LOGIN_FAILURES_PER_IP=10
SECURITY_INGEST_RPM=100

# Cost / billing (enterprise)
COST_ENTERPRISE_ENABLED=false
COST_BILLING_API_ENABLED=false
CURSOR_BILLING_API_URL=https://api.cursor.com/teams/spend
CURSOR_BILLING_API_KEY=

# MCP token TTL (days) — prod profile defaults to 7
MCP_TOKEN_EXPIRATION_DAYS=30

# Retention
RETENTION_TASK_EVENTS_DAYS=90

# ClickHouse analytics sink (optional — docker compose --profile analytics)
# See docs/CLICKHOUSE_ANALYTICS.md
CLICKHOUSE_ENABLED=false
CLICKHOUSE_READ_ENABLED=true
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=agent_retry
CLICKHOUSE_HTTP_PORT=8123

# Insights chatbot (local Ollama)
CHAT_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=llama3.2
CHAT_RPM=30
CHAT_DETERMINISTIC_FALLBACK=true

# Claude Cowork OTel ingest (manager /api/v1/otel/v1/logs)
OTEL_INGEST_ENABLED=true
OTEL_COWORK_MAPPING_ENABLED=true
OTEL_MAX_REQUEST_BODY_BYTES=5242880
OTEL_MAX_LOG_RECORDS=1000
# Optional Enterprise Analytics API reconcile (stub until key is set)
COWORK_ANALYTICS_API_ENABLED=false
COWORK_ANALYTICS_API_URL=
COWORK_ANALYTICS_API_KEY=
